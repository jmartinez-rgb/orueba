# Deny by default: Docker may receive only the source/build inputs listed below.
**
!package.json
!package-lock.json
!next.config.ts
!tsconfig.json
!postcss.config.mjs
!src/**/*.ts
!src/**/*.tsx
!src/**/*.css
!scripts/*.ts
!scripts/*.mjs
!config/sheets.mapping.json
!config/bigquery.mapping.example.json
!config/bigquery.mapping.hourly-example.json
!config/unified.mapping.example.json
!public/favicon.svg

# Defense in depth for generated/private material inside an otherwise allowed directory.
**/.env*
**/.data*
**/.data*/**
**/node_modules
**/node_modules/**
**/.next
**/.next/**
**/.git
**/.git/**
**/.netlify
**/.netlify/**
**/coverage
**/coverage/**
**/*credential*.json
**/*service-account*.json
**/*service_account*.json
**/*secret*.json
**/*key*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.xlsx
**/*.xls
**/*.csv
**/*.zip
**/*.log
**/*.tsbuildinfo
