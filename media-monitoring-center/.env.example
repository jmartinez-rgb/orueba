# ─────────────────────────────────────────────────────────────────────────────
# izzi Media Monitoring Center · variables de entorno (EJEMPLO, sin valores reales)
# Copia a .env.local para desarrollo. En Netlify: Site configuration > Environment variables.
# NUNCA subas .env ni credenciales al repositorio. Detalle en docs/ENVIRONMENT.md
# ─────────────────────────────────────────────────────────────────────────────

# App (NEXT_PUBLIC_* es lo único visible en el navegador: nunca pongas secretos ahí)
NEXT_PUBLIC_APP_NAME=izzi Media Monitoring Center

# Fuente de datos: mock (simulados) | sheets (hoja de Google Sheets que llena Dataslayer) | bigquery.
# Si falta la configuración de la fuente elegida, la app usa datos simulados y lo avisa en Integrations.
DATA_SOURCE=mock
# (Compatibilidad) Sin DATA_SOURCE: true = simulados; false = Sheets o BigQuery según lo configurado.
USE_MOCK_DATA=true
# Escenario inicial del mock: default | normal | meta-delayed | tiktok-stopped
MOCK_SCENARIO=default
# Opcional: fija la hora de referencia del mock (demos reproducibles), ISO 8601.
# MOCK_REFERENCE_TIME=2026-09-28T18:05:00Z

# Zona horaria de negocio (todas las comparaciones lunes vs lunes / hora vs hora)
APP_TIMEZONE=America/Mexico_City

# ── Google Sheets (Dataslayer) · docs/INSTALACION.md ─────────────────────────
# ID de la hoja (lo que va entre /d/ y /edit en la URL). La app solo la lee, con la cuenta de
# servicio de abajo (compártele la hoja como Lector). Se configura con: npm run sheets:setup
SHEETS_SPREADSHEET_ID=
# Mapeo de pestañas y columnas (por defecto config/sheets.mapping.json, versionado, sin secretos).
# SHEETS_MAPPING_FILE=config/sheets.mapping.json

# ── Google BigQuery (opcional) ───────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=
BIGQUERY_DATASET=
# Dataset para tablas propias de la app (alertas, incidentes...). Por defecto = BIGQUERY_DATASET.
BIGQUERY_STATE_DATASET=
BIGQUERY_LOCATION=US
# Límite de bytes facturados por consulta (protección de costo). 5 GB por defecto.
BIGQUERY_MAX_BYTES_BILLED=5368709120
# Mapeo de tablas/columnas (JSON). Si no se define, se lee config/bigquery.mapping.json.
BIGQUERY_MAPPING=
# BIGQUERY_MAPPING_FILE=config/bigquery.mapping.json

# Cuenta de servicio de Google (Sheets y/o BigQuery). Elige UNA opción. En Netlify se recomienda
# la opción B por el límite de 4 KB para todas las variables de las Functions.
# A) JSON completo de la service account (texto o base64)
GOOGLE_SERVICE_ACCOUNT=
# B) Solo correo y llave privada (los \n de la llave pueden ir escapados)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ── n8n (orquestación) ──────────────────────────────────────────────────────
N8N_BASE_URL=
# Rutas relativas a N8N_BASE_URL o URLs completas
N8N_MONITORING_WEBHOOK=
N8N_ALERT_WEBHOOK=
N8N_MANUAL_SYNC_WEBHOOK=
# Secreto para firmar (HMAC SHA-256) los webhooks que la app envía a n8n
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT_MS=10000
# Llave que n8n usa para llamar POST /api/monitoring/evaluate (Authorization: Bearer ...)
MONITORING_API_KEY=

# ── WhatsApp Business Cloud API (vía n8n) ───────────────────────────────────
# El token de WhatsApp vive SOLO en las credenciales de n8n. La app solo necesita
# saber si está activo y el nombre de las plantillas aprobadas.
WHATSAPP_ALERTS_ENABLED=false
WHATSAPP_TEMPLATE_ALERT=izzi_media_alert
WHATSAPP_TEMPLATE_RECOVERY=izzi_media_recovery
WHATSAPP_TEMPLATE_LANGUAGE=es_MX

# ── Acceso con contraseña ───────────────────────────────────────────────────
# Genera todo con:  npm run auth:setup            (imprime contraseñas y variables)
#                   npm run auth:setup -- --write (además lo guarda en .env.local)
# Los valores reales van SOLO en .env.local y en Netlify, nunca en el repositorio. Detalle: docs/AUTH.md
# Sin AUTH_SECRET + credenciales: en local se entra sin contraseña (aviso "modo abierto");
# en producción el sitio queda BLOQUEADO hasta configurarlas.
# Firma de sesiones: 32+ caracteres aleatorios.
AUTH_SECRET=
# Cuentas nominales (JSON en una línea): [{"u":"usuario","n":"Nombre visible","r":"admin|coadmin|manager|viewer","h":"scrypt:..."}]
AUTH_USERS=
# Contraseña universal (hash): cada persona entra con su nombre y apellido; rol viewer o manager.
AUTH_UNIVERSAL_PASSWORD_HASH=
AUTH_UNIVERSAL_ROLE=viewer
# Duración de la sesión en horas (1 a 336)
AUTH_SESSION_HOURS=12
# Vacío = automático (recomendado). open = sin contraseña (solo demo local). header = identidad
# en cabeceras de un proxy/SSO de confianza. El valor antiguo "dev" cuenta como automático.
AUTH_MODE=
# Rol con el que se entra en modo abierto (demo local)
AUTH_DEFAULT_ROLE=admin

# ── Registros de la app (bitácora de accesos, tickets, acuses, historial de mensajes) ─
# En Netlify se usan Netlify Blobs automáticamente (sin configurar nada). En local, archivos
# en .data/records (ignorado por git). Las métricas nunca se guardan aquí: viven en BigQuery.
# RECORDS_BACKEND=blobs|file|memory
# RECORDS_DIR=.data/records

# debug | info | warn | error
LOG_LEVEL=info
