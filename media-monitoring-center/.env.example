# ─────────────────────────────────────────────────────────────────────────────
# izzi Media Monitoring Center · variables de entorno (EJEMPLO, sin valores reales)
# Copia a .env.local para desarrollo. En Netlify: Site configuration > Environment variables.
# NUNCA subas .env ni credenciales al repositorio. Detalle en docs/ENVIRONMENT.md
# ─────────────────────────────────────────────────────────────────────────────

# App (NEXT_PUBLIC_* es lo único visible en el navegador: nunca pongas secretos ahí)
NEXT_PUBLIC_APP_NAME=izzi Media Monitoring Center

# Datos: true = datos simulados realistas (8+ semanas, 6 plataformas, anomalías).
# false = consulta BigQuery (requiere proyecto, dataset y mapeo válido; si falta algo vuelve a mock).
USE_MOCK_DATA=true
# Escenario inicial del mock: default | normal | meta-delayed | tiktok-stopped
MOCK_SCENARIO=default
# Opcional: fija la hora de referencia del mock (demos reproducibles), ISO 8601.
# MOCK_REFERENCE_TIME=2026-09-28T18:05:00Z

# Zona horaria de negocio (todas las comparaciones lunes vs lunes / hora vs hora)
APP_TIMEZONE=America/Mexico_City

# ── Google BigQuery (fuente única de verdad) ────────────────────────────────
GOOGLE_CLOUD_PROJECT=
BIGQUERY_DATASET=
# Dataset para tablas propias de la app (alertas, incidentes...). Por defecto = BIGQUERY_DATASET.
BIGQUERY_STATE_DATASET=
BIGQUERY_LOCATION=US
# Límite de bytes facturados por consulta (protección de costo). 5 GB por defecto.
BIGQUERY_MAX_BYTES_BILLED=5368709120
# Mapeo de tablas/columnas (JSON). Si no se define, se lee config/bigquery.mapping.json.
BIGQUERY_MAPPING=
# BIGQUERY_MAPPING_FILE=config/bigquery.mapping.json

# Credenciales (elige UNA opción). En Netlify se recomienda la opción B por el límite
# de 4 KB para todas las variables de las Functions.
# A) JSON completo de la service account (texto o base64)
GOOGLE_SERVICE_ACCOUNT=
# B) Solo correo y llave privada (los \n de la llave pueden ir escapados)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ── n8n (orquestación) ──────────────────────────────────────────────────────
N8N_BASE_URL=
# Rutas relativas a N8N_BASE_URL o URLs completas
N8N_MONITORING_WEBHOOK=
N8N_ALERT_WEBHOOK=
N8N_MANUAL_SYNC_WEBHOOK=
# Secreto para firmar (HMAC SHA-256) los webhooks que la app envía a n8n
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT_MS=10000
# Llave que n8n usa para llamar POST /api/monitoring/evaluate (Authorization: Bearer ...)
MONITORING_API_KEY=

# ── WhatsApp Business Cloud API (vía n8n) ───────────────────────────────────
# El token de WhatsApp vive SOLO en las credenciales de n8n. La app solo necesita
# saber si está activo y el nombre de las plantillas aprobadas.
WHATSAPP_ALERTS_ENABLED=false
WHATSAPP_TEMPLATE_ALERT=izzi_media_alert
WHATSAPP_TEMPLATE_RECOVERY=izzi_media_recovery
WHATSAPP_TEMPLATE_LANGUAGE=es_MX

# ── Autenticación ───────────────────────────────────────────────────────────
# dev = rol elegido desde la interfaz (solo desarrollo). header = rol en cabeceras de un proxy/SSO de confianza.
AUTH_MODE=dev
AUTH_DEFAULT_ROLE=admin

# debug | info | warn | error
LOG_LEVEL=info
