{
  "name": "unified-ads-api",
  "version": "0.1.0",
  "private": true,
  "description": "API unificada de plataformas publicitarias (Google, Meta, TikTok, Microsoft, Spotify, X) para n8n, BigQuery, dashboard y alertas.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "google:auth": "tsx scripts/google-auth.ts",
    "microsoft:auth": "tsx scripts/microsoft-auth.ts",
    "microsoft:red": "tsx scripts/microsoft-network.ts",
    "spotify:auth": "tsx scripts/spotify-auth.ts",
    "tiktok:auth": "tsx scripts/tiktok-auth.ts",
    "meta:exclusiones": "tsx scripts/meta-exclusions.ts",
    "verificar": "tsx scripts/verify.ts",
    "meta:acciones": "tsx scripts/meta-actions.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "fflate": "^0.8.3",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
