# ─── Servidor ────────────────────────────────────────────────────────────────
NODE_ENV=development
# 127.0.0.1 = solo tu computadora. El contenedor (Dockerfile) usa 0.0.0.0.
HOST=127.0.0.1
# Cloud Run inyecta PORT; en local se usa 8080.
PORT=8080
LOG_LEVEL=info

# ─── Seguridad ───────────────────────────────────────────────────────────────
# Llaves internas separadas por coma (encabezado X-API-Key). Cada una en texto (mín. 24
# caracteres) o, mejor en producción, como huella: sha256:<hex de 64 caracteres>.
# Genera una llave:   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Su huella:          node -e "console.log('sha256:'+require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" "LA_LLAVE"
API_KEYS=
# Orígenes permitidos para el dashboard (vacío = ninguno).
CORS_ORIGINS=
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
# true detrás de un balanceador (Cloud Run) para leer la IP real del cliente.
TRUST_PROXY=false
# Documentación Swagger en /docs.
DOCS_ENABLED=true
# Tiempo máximo por consulta a un proveedor (ms).
PROVIDER_TIMEOUT_MS=15000
# Archivo privado donde se conservan los refresh tokens que Microsoft y Spotify rotan al renovar.
# Sin él, el token nuevo se pierde al reiniciar y el original vence (Microsoft: 90 días desde que se
# emitió). Usa un nombre ignorado por Git, por ejemplo .env.tokens. Nunca lo subas al repositorio.
# TOKEN_STORE_FILE=.env.tokens

# ─── Proveedores ─────────────────────────────────────────────────────────────
# Google Ads (Fase 2): documentación y permisos en docs/GOOGLE_ADS.md.
GOOGLE_ADS_API_VERSION=v25
# Opcional en v25 (acceso por proyecto Cloud); requerido para el modo legacy v24.
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth: se puede obtener el refresh token con npm run google:auth.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Opcional: proyecto de cuota que se envía en x-goog-user-project.
GOOGLE_ADS_CLOUD_PROJECT=
# MCC para acceder a sus cuentas, con o sin guiones.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Opcional: raíces a consultar al listar todas las cuentas, separadas por coma.
GOOGLE_ADS_CUSTOMER_IDS=
# JSON: {"1234567890":"cliente-interno"}. client_id filtra por este mapeo.
GOOGLE_ADS_CLIENT_MAPPING=
# JSON: {"ID de acción o nombre o categoría":"PURCHASE|LEAD|WHATSAPP|..."}.
GOOGLE_ADS_CONVERSION_MAPPING=
GOOGLE_ADS_TIMEOUT_MS=15000
GOOGLE_ADS_RETRIES=2
# Alternativa a refresh token: cuenta de servicio, JSON completo o ruta a archivo privado.
# GOOGLE_ADS_SERVICE_ACCOUNT_JSON=
# GOOGLE_ADS_SERVICE_ACCOUNT_FILE=
# Solo para delegación de dominio autorizada (opcional):
# GOOGLE_ADS_IMPERSONATED_USER=
# Callback del asistente local (registrarlo exactamente en el cliente OAuth de Google):
# GOOGLE_ADS_REDIRECT_URI=http://127.0.0.1:8089/oauth/google/callback

# Meta Marketing API (Fase 3): docs/META_ADS.md.
META_API_VERSION=v26.0
META_ACCESS_TOKEN=
# Opcional; requerido cuando la app exige appsecret_proof.
META_APP_SECRET=
# false permite ads_read sin pedir el campo business; true necesita business_management.
META_INCLUDE_BUSINESS_METADATA=false
# Opcional: cuentas numéricas o act_<ID> por comas (útil para usuario del sistema).
META_AD_ACCOUNT_IDS=
# Opcional: owned_ad_accounts y client_ad_accounts; puede necesitar business_management.
META_BUSINESS_IDS=
# JSON cuenta -> cliente interno.
META_CLIENT_MAPPING=
# JSON tipo de acción -> categoría; mensajería no se supone WhatsApp.
META_CONVERSION_MAPPING=
# Una acción exacta para conversiones/valor/CPA; sin definir, quedan en null.
META_PRIMARY_CONVERSION_ACTION=
# JSON cuenta -> acción principal, sobrescribe la global.
META_PRIMARY_CONVERSION_MAPPING=
META_TIMEOUT_MS=15000
META_RETRIES=2

# TikTok Ads (Fase 4): docs/TIKTOK_ADS.md. Contrato GET v1.3.
TIKTOK_API_VERSION=v1.3
# App ID y secret se usan para descubrir cuentas autorizadas.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Token de anunciante de larga duración emitido para tu app.
TIKTOK_ACCESS_TOKEN=
# Opcional: IDs de cuenta separados por coma; evita discovery y permite usar solo token.
TIKTOK_ADVERTISER_IDS=
# JSON cuenta -> cliente interno. Los IDs siempre son texto, nunca números JS.
TIKTOK_CLIENT_MAPPING=
# conversion = evento de optimización; puedes elegir complete_payment, form, onsite_form, etc.
TIKTOK_PRIMARY_CONVERSION_METRIC=conversion
# JSON cuenta -> métrica principal, sobrescribe la global.
TIKTOK_PRIMARY_CONVERSION_MAPPING=
# Opcional: métricas de conversiones separadas por coma, de la lista admitida en la guía.
TIKTOK_CONVERSION_METRICS=
# JSON métrica -> categoría interna. conversion no presume LEAD/PURCHASE/WHATSAPP.
TIKTOK_CONVERSION_MAPPING=
TIKTOK_TIMEOUT_MS=15000
TIKTOK_RETRIES=2

# Microsoft Advertising (Fase 5): REST v13, informes ZIP/CSV asíncronos. docs/MICROSOFT_ADS.md
MICROSOFT_ADS_DEVELOPER_TOKEN=
MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_CLIENT_SECRET=
MICROSOFT_ADS_REFRESH_TOKEN=
MICROSOFT_ADS_TENANT=common
# Microsoft usa 120 s por omisión (solicita, espera y descarga el informe). Este valor propio
# manda sobre PROVIDER_TIMEOUT_MS; no hace falta elevar el límite global.
# MICROSOFT_ADS_TIMEOUT_MS=120000
MICROSOFT_ADS_POLL_INTERVAL_MS=5000
MICROSOFT_ADS_RETRIES=2
MICROSOFT_ADS_RETURN_ONLY_COMPLETE_DATA=false
# Limitar descubrimiento a cuentas conocidas (IDs numéricos, separados por coma).
MICROSOFT_ADS_ACCOUNT_IDS=
MICROSOFT_ADS_CLIENT_MAPPING={}
# Mapeo por GoalId, o por nombre exacto de objetivo; no inventa categorías por GoalType.
MICROSOFT_ADS_CONVERSION_MAPPING={}
# Asistente opcional desde el navegador. Callback completo solo en variable privada temporal.
# MICROSOFT_ADS_REDIRECT_URI=http://localhost:8089/oauth/microsoft/callback
# MICROSOFT_ADS_AUTH_CALLBACK_URL=

# Spotify Ads (Fase 6): Ads API v3. docs/SPOTIFY_ADS.md. OAuth de usuario, scope vacío.
SPOTIFY_ADS_CLIENT_ID=
SPOTIFY_ADS_CLIENT_SECRET=
SPOTIFY_ADS_REFRESH_TOKEN=
SPOTIFY_ADS_API_VERSION=v3
# Asistente desde el navegador: IP literal, no localhost. Callback completo siempre privado.
# SPOTIFY_ADS_REDIRECT_URI=http://127.0.0.1:8089/oauth/spotify/callback
# SPOTIFY_ADS_AUTH_CALLBACK_URL=
# SPOTIFY_ADS_ACCOUNT_IDS=uuid1,uuid2
# SPOTIFY_ADS_BUSINESS_IDS=uuid1,uuid2
# SPOTIFY_ADS_CLIENT_MAPPING={"uuid":"cliente-interno"}
# Elegir una acción exacta; por defecto conversiones y CPA de rendimiento son null.
# SPOTIFY_ADS_PRIMARY_CONVERSION_METRIC=LEADS
# SPOTIFY_ADS_PRIMARY_CONVERSION_MAPPING={"uuid":"PURCHASES"}
# SPOTIFY_ADS_CONVERSION_MAPPING={"CUSTOM_EVENT_1":"lead"}
# SPOTIFY_ADS_TIMEOUT_MS=15000
# SPOTIFY_ADS_RETRIES=2
# X Ads (fase 7): OAuth 1.0a de usuario; docs/X_ADS.md. Valores privados, nunca en Git.

X_ADS_CONSUMER_KEY=
X_ADS_CONSUMER_SECRET=
X_ADS_ACCESS_TOKEN=
X_ADS_ACCESS_TOKEN_SECRET=
X_ADS_API_VERSION=12
# X_ADS_ACCOUNT_IDS=abc123,def456
# X_ADS_CLIENT_MAPPING={"abc123":"izzi"}
# Sin acción principal explícita: conversiones y CPA de performance permanecen null.
# X_ADS_PRIMARY_CONVERSION_METRIC=conversion_purchases
# X_ADS_PRIMARY_CONVERSION_MAPPING={"abc123":"conversion_sign_ups"}
# X_ADS_CONVERSION_MAPPING={"conversion_custom":"LEAD"}
# post_engagement y post_view se mantienen separados.
X_ADS_CONVERSION_ATTRIBUTION=post_engagement
X_ADS_REPORT_MODE=auto
# Ubicaciones que se suman (por omisión ALL_ON_TWITTER,SPOTLIGHT,TREND); admite PUBLISHER_NETWORK.
X_ADS_PLACEMENTS=
# X_ADS_TIMEOUT_MS=120000
X_ADS_RETRIES=2
